{
  "name": "@particle-academy/fancy-connectors",
  "version": "0.1.0",
  "private": true,
  "description": "The Fancy connector catalogue. Connectors ship as VENDORED SOURCE — you copy one directory into your project and own it — so this package is never published; the registry serves the source and `fancy-cli` copies it. Built on @particle-academy/fancy-connector-core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-connectors.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-connectors#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-connectors/issues",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "probe": "node --import tsx scripts/probe.ts",
    "drift": "node --import tsx scripts/drift.ts",
    "link-core": "node scripts/link-core.mjs"
  },
  "dependencies": {
    "@particle-academy/fancy-connector-core": ">=0.5.0 <2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "connectors",
    "api",
    "integrations",
    "vendored",
    "fancy-ui",
    "particle-academy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
